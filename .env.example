# Set securely in Railway Variables, never commit real values
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
RATE_LIMIT_SECRET=
# Generate a password hash locally: python -c "from argon2 import PasswordHasher; import getpass; print(PasswordHasher().hash(getpass.getpass()))"
ADMIN_PASSWORD_HASH=
# Generate once and add to an authenticator app by scanning locally generated TOTP QR or manual setup.
# Generate: python -c "import pyotp; print(pyotp.random_base32())"
ADMIN_TOTP_SECRET=
# Create using @BotFather, bot token stays server-side
TELEGRAM_BOT_TOKEN=
# Private chat ID of the psychologist; she must first send /start to the bot
TELEGRAM_CHAT_ID=
# Optional exact https://domain, used for origin verification
PUBLIC_ORIGIN=
